# Optional override for an API hosted on a different machine.
# Leave this unset when the web UI and API run on the same host: the UI uses
# the browser's current hostname with API port 5000 automatically.
# VITE_API_BASE_URL=http://api-hostname-or-ip:5000

# Optional Google Maps JavaScript API key for the future /nodes map.
# Use a separate web key. Vite embeds VITE_ values in the browser bundle, so
# this is not a server secret; restrict the real key to Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=replace_with_web_maps_key
