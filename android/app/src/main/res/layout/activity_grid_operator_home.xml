<?xml version="1.0" encoding="utf-8"?>

<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="24dp">

		<TextView
			android:id="@+id/operatorNameText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Grid Operator"
			android:textSize="24sp"
			android:textStyle="bold"
			android:paddingBottom="24dp" />

		<!-- Map -->
		<Button
			android:id="@+id/mapButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Map" />

		<!-- Nearby Stations -->
		<Button
			android:id="@+id/nearbyStationsButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="Nearby Grid Nodes" />

		<!-- QR Scanner -->
		<Button
			android:id="@+id/scanQrButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="Scan QR Code" />

		<!-- Booking Verification -->
		<Button
			android:id="@+id/verifyBookingButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="Verify Booking" />

		<!-- Finalize Transfer -->
		<Button
			android:id="@+id/finalizeTransferButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="Finalize Transfer" />

	</LinearLayout>

</ScrollView>