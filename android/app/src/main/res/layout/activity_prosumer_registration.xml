<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout style="@style/HeaderBar">

            <ImageButton
                android:id="@+id/pageBackButton"
                style="@style/HeaderBackButton"
                android:contentDescription="Back to Sign in"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Prosumer Registration" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create your Prosumer account and sign in immediately." />

            <LinearLayout
                android:id="@+id/registrationForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/dashboard_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NIC" />

                <EditText
                    android:id="@+id/nicInput"
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Full name" />

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:inputType="textPersonName" />

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email" />

                <EditText
                    android:id="@+id/emailInput"
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phone (optional)" />

                <EditText
                    android:id="@+id/phoneInput"
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:inputType="phone"
                    android:singleLine="true" />

                <TextView
                    style="@style/InputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Password" />

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/InputField"
                    android:layout_marginTop="8dp"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/registerButton"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="24dp"
                    android:text="Create account" />

                <TextView
                    android:id="@+id/feedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/status_panel"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/registrationSuccessPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/dashboard_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account created"
                    android:textColor="@color/status_success"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Your Prosumer account is active. You can sign in now."
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/backToSignInButton"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="24dp"
                    android:text="Back to Sign in" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>