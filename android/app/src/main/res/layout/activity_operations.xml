<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout style="@style/HeaderBar">

        <ImageButton
            android:id="@+id/pageBackButton"
            style="@style/HeaderBackButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Grid Operator Operations" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservations" />

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Manage reservations and finalize approved energy transfers." />

            <!-- Pending reservations -->
            <Button
                android:id="@+id/pendingReservationsButton"
                style="@style/PrimaryButton"
                android:layout_marginTop="20dp"
                android:text="Pending Reservations" />

            <!-- Approved reservations -->
            <Button
                android:id="@+id/approvedReservationsButton"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="Approved Reservations" />

        </LinearLayout>

    </LinearLayout>

    <include
        layout="@layout/view_bottom_navigation" />

</LinearLayout>