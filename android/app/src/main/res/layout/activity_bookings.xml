<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F7FAFC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="#0B2A45">
        <ImageButton android:id="@+id/pageBackButton" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:padding="11dp" android:src="@drawable/ic_back" android:tint="#FFFFFF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SmartSolar" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textColor="#FFC52F" android:textSize="30sp" />
    </LinearLayout>
    <TextView android:id="@+id/reservationFeedbackText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:background="@drawable/status_panel" android:padding="12dp" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/reservationTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="8dp">
        <Button android:id="@+id/createReservationTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Create" android:textAllCaps="false" />
        <Button android:id="@+id/myReservationsTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="My Reservations" android:textAllCaps="false" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/reservationContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
