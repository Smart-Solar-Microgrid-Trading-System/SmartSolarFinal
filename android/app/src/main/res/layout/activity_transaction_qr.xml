<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding">

    <include layout="@layout/view_top_app_bar" />

    <TextView
        android:id="@+id/qrInstructionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Show this QR code to the Grid Operator to verify your energy transfer."
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- QR Code -->

    <ImageView
        android:id="@+id/transactionQrImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:contentDescription="Transaction QR code"
        android:scaleType="fitCenter" />

    <!-- Status -->

    <TextView
        android:id="@+id/transactionStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Preparing secure transaction QR..."
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Reservation -->

    <TextView
        android:id="@+id/reservationIdText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
