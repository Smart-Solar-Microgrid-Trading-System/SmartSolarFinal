<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Smart Solar Microgrid" android:textColor="@color/brand_blue" android:textSize="24sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/settingsIconButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Server Settings" android:padding="12dp" android:src="@drawable/ic_settings" />
            </LinearLayout>
            <TextView android:id="@+id/roleSubtitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="14sp" />

            <TextView android:id="@+id/greetingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:textColor="#172B4D" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:id="@+id/signedInText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="14sp" />

            <LinearLayout android:id="@+id/prosumerBenefitsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/dashboard_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plan your energy use" android:textColor="#172B4D" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Manage your solar energy bookings in one place." android:textColor="@color/text_secondary" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Find nearby grid nodes and reserve available slots." android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:id="@+id/activityTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Your energy activity" android:textColor="#172B4D" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/dashboard_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/activeLabelText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active bookings" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/activeBookingCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/brand_blue" android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:id="@+id/activeDescriptionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Available after booking API" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/dashboard_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/pendingLabelText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending bookings" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/pendingBookingCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/brand_blue" android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pendingDescriptionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Available after booking API" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Quick actions" android:textColor="#172B4D" android:textSize="17sp" android:textStyle="bold" />
            <Button android:id="@+id/bookingShortcutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:drawableStart="@drawable/ic_bookings" android:drawablePadding="10dp" android:gravity="center_vertical" android:text="View bookings" />
            <Button android:id="@+id/mapShortcutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_map" android:drawablePadding="10dp" android:gravity="center_vertical" android:text="Find nearby grid nodes" />

            <TextView android:id="@+id/serviceStatusTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Service status" android:textColor="#172B4D" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/status_panel" android:padding="14dp" android:textSize="14sp" />
            <Button android:id="@+id/openServerSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Open Server Settings" android:visibility="gone" />
            <Button android:id="@+id/signOutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Sign out" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
